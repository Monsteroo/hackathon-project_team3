# Скопіюй у frontend/.env.local (не комітиться) і впиши одне зі значень API_KEYS з backend/.env.
# Без ключа бекенд відповідає 401, а голос працює лише через Web Speech у браузері.
VITE_API_KEY=<API_KEY>
# Локально не потрібен (запити йдуть через Vite proxy); для продакшену без проксі вкажіть URL бекенду:
# VITE_API_BASE_URL=https://sayvy-backend.onrender.com
