# Шаблон змінних середовища. Скопіюйте в .env і заповніть.
# На Vercel ці самі змінні задаються в Project Settings → Environment Variables.

# --- Голос → текст (Groq) ---
GROQ_API_KEY=your_groq_key_here
GROQ_STT_MODEL=whisper-large-v3
# Чистка тексту: обрано за тестом 21.11 (qwen — найточніша й найшвидша), запасна — gpt-oss-120b
GROQ_CLEANUP_MODEL=qwen/qwen3.8-27b
GROQ_CLEANUP_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Геокодинг і маршрути (без ключів) ---
# Політика Nominatim вимагає User-Agent з контактом. На Vercel вкажіть контакт команди, напр.:
# GEO_USER_AGENT=voicecart-hackathon/0.1 (+https://github.com/<org>/<repo>)
GEO_USER_AGENT=voicecart-hackathon/0.1
# Міста демо (через кому; межі — CITY_BBOX у backend/config.py)
SERVICE_CITIES=Київ
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
VALHALLA_URL=https://valhalla1.openstreetmap.de
