# Скопіюй у backend/.env і заповни. Сам .env у git не потрапляє.

# Локальний Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicecart
DB_SSL=false

# Supabase: Project Settings -> Database -> Connect -> Session pooler (порт 5432).
# User має вигляд postgres.<project-ref>, пароль треба URL-encoded.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# DB_SSL=true

# Пул маленький: в одну базу Supabase ходить уся команда
DB_POOL_SIZE=5

# Звідки фронт може звертатися до API (JSON-список)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Ключі доступу до API (заголовок X-API-Key), через кому: окремий на кожного клієнта (фронт, агент, Postman).
# Згенерувати: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Якщо порожньо, захищені ендпоінти відповідають 503.
API_KEYS=

# Які модулі підключати, через кому (за замовчуванням усі). Окремий деплой каталогу: ENABLED_MODULES=catalog
# ENABLED_MODULES=catalog,geo,voice

# Планувальник фонових задач у процесі FastAPI. Задачі запускаються, лише поки працює сервер.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Kyiv

# Нічний ETL каталогу (формат crontab): щодня о 03:00 за SCHEDULER_TIMEZONE
ETL_CRON="0 3 * * *"
ETL_CITY=Київ
ETL_CONCURRENCY=5
# Обмеження для швидких тестових прогонів (за замовчуванням без обмежень)
# ETL_ZAKAZ_STORE_LIMIT=2
# ETL_SILPO_BRANCH_LIMIT=5

# --- Модуль geo (Учасник 1) ---
# Міста демо через кому (межі — app/geo/area.py)
SERVICE_CITIES=Київ
# «Є ціни» = offers_count у /catalog/stores не менше за поріг
PRICED_MIN_OFFERS=50
# Політика Nominatim вимагає User-Agent з контактом. На сервері вкажіть контакт команди, напр.:
# GEO_USER_AGENT=voicecart-hackathon/0.1 (+https://github.com/<org>/<repo>)
GEO_USER_AGENT=voicecart-hackathon/0.1
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
VALHALLA_URL=https://valhalla1.openstreetmap.de

# --- Модуль voice (Учасник 1) ---
# Ключ Groq: https://console.groq.com (безкоштовний тариф підходить для демо)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_CLEANUP_MODEL=qwen/qwen3.8-27b
GROQ_CLEANUP_FALLBACK_MODEL=openai/gpt-oss-120b
# Ліміт запитів до /voice/* з одного IP за хвилину (захист платних викликів; ключ у бандлі фронту не секретний)
VOICE_RATE_LIMIT_PER_MIN=10
