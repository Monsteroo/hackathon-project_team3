[
  {"id": "v01", "spoken": "ееее мені треба молоко галичина літр, два десятки яєць і кава якобс монарх, бюджет двісті п'ятдесят гривень", "must_contain": ["молоко", "галичина", "20", "яєць", "кав", "250 грн"], "must_not_contain": ["ееее"], "mode": null, "radius_km": null},
  {"id": "v02", "spoken": "хочу зробити сирники на сніданок без цукру і без пальмової олії, на чотири людини, щоб недалеко йти", "must_contain": ["сирники", "без цукру", "пальмов", "4"], "must_not_contain": [], "mode": "walk", "radius_km": 1.0},
  {"id": "v03", "spoken": "ну типу хліб, масло і сметана, далеко йти не хочу", "must_contain": ["хліб", "масло", "сметан"], "must_not_contain": ["типу"], "mode": "walk", "radius_km": 1.0},
  {"id": "v04", "spoken": "кетчуп торчин, майонез і вода моршинська, поїду на машині", "must_contain": ["кетчуп", "торчин", "майонез", "моршинськ"], "must_not_contain": [], "mode": "car", "radius_km": null},
  {"id": "v05", "spoken": "борщ на шість людей без свинини, в радіусі трьох кілометрів", "must_contain": ["борщ", "6", "без свинини"], "must_not_contain": [], "mode": null, "radius_km": 3.0},
  {"id": "v06", "spoken": "короче кава розчинна і шоколад рошен з фундуком, пішки", "must_contain": ["кава", "шоколад", "рошен", "фундук"], "must_not_contain": ["короче"], "mode": "walk", "radius_km": null},
  {"id": "v07", "spoken": "кілограм гречки, півтора кіло курячого філе і десяток яєць", "must_contain": ["1 кг", "гречк", "1,5 кг", "філе", "10"], "must_not_contain": [], "mode": null, "radius_km": null},
  {"id": "v08", "spoken": "молоко без лактози і йогурт грецький, на авто до десяти кілометрів", "must_contain": ["молоко", "без лактози", "йогурт"], "must_not_contain": [], "mode": "car", "radius_km": 10.0},
  {"id": "v09", "spoken": "ммм сир кисломолочний п'ять відсотків, два пакети", "must_contain": ["сир", "кисломолочн", "5", "2"], "must_not_contain": ["ммм"], "mode": null, "radius_km": null},
  {"id": "v10", "spoken": "продукти на вечерю для двох до трьохсот гривень, поруч з домом", "must_contain": ["вечер", "2", "300 грн"], "must_not_contain": [], "mode": "walk", "radius_km": 1.0},
  {"id": "v11", "spoken": "яблука, банани, ой ні, апельсини і кефір", "must_contain": ["яблука", "апельсин", "кефір"], "must_not_contain": ["банани"], "mode": null, "radius_km": null},
  {"id": "v12", "spoken": "пиво не треба, тільки чипси і кола зеро пів літра", "must_contain": ["чипси", "кола", "0,5 л"], "must_not_contain": [], "mode": null, "radius_km": null},
  {"id": "v13", "spoken": "макарони, томатна паста і пармезан, в радіусі п'ятисот метрів", "must_contain": ["макарони", "томатн", "пармезан"], "must_not_contain": [], "mode": null, "radius_km": 0.5},
  {"id": "v14", "spoken": "значить так, вода три пляшки по півтора літра і мінералка", "must_contain": ["вода", "3", "1,5 л", "мінералк"], "must_not_contain": ["значить"], "mode": null, "radius_km": null},
  {"id": "v15", "spoken": "все для піци: борошно, дріжджі, моцарела, без глютену не треба", "must_contain": ["піц", "борошно", "дріжджі", "моцарел"], "must_not_contain": [], "mode": null, "radius_km": null},
  {"id": "v16", "spoken": "олія соняшникова літр і цукор два кілограми, доїду машиною", "must_contain": ["олія", "1 л", "цукор", "2 кг"], "must_not_contain": [], "mode": "car", "radius_km": null},
  {"id": "v17", "spoken": "ну як би курка, рис і овочі для салату, недалеко", "must_contain": ["курк", "рис", "овоч", "салат"], "must_not_contain": ["як би"], "mode": "walk", "radius_km": 1.0},
  {"id": "v18", "spoken": "дитяче пюре і підгузки, пішки не більше одного кілометра", "must_contain": ["пюре", "підгуз"], "must_not_contain": [], "mode": "walk", "radius_km": 1.0},
  {"id": "v19", "spoken": "сніданок на тиждень на сімсот гривень", "must_contain": ["сніданок", "тиждень", "700 грн"], "must_not_contain": [], "mode": null, "radius_km": null},
  {"id": "v20", "spoken": "ееее ну ммм чай зелений і печиво", "must_contain": ["чай", "зелений", "печиво"], "must_not_contain": ["ееее", "ммм"], "mode": null, "radius_km": null},
  {"id": "v21", "spoken": "морозиво пломбір дві штуки і вершки, на таксі", "must_contain": ["морозиво", "пломбір", "2", "вершки"], "must_not_contain": [], "mode": "car", "radius_km": null},
  {"id": "v22", "spoken": "сосиски, гірчиця і батон, біля дому", "must_contain": ["сосиски", "гірчиц", "батон"], "must_not_contain": [], "mode": "walk", "radius_km": 1.0},
  {"id": "v23", "spoken": "огірки, помідори, зелень, у радіусі двох кілометрів пішки", "must_contain": ["огірки", "помідори", "зелень"], "must_not_contain": [], "mode": "walk", "radius_km": 2.0},
  {"id": "v24", "spoken": "риба червона сто п'ятдесят грам і авокадо", "must_contain": ["риба", "150 г", "авокадо"], "must_not_contain": [], "mode": null, "radius_km": null},
